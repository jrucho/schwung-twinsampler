{
  "title": "TwinSampler",
  "children": [
    {
      "title": "Sample / Chop Editor",
      "lines": [
        "Down: waveform trim",
        "Down again: SRC chops",
        "K3/K4: start/end",
        "Shift: coarse edges",
        "Shift+Jog: zoom",
        "L/R: looper pad view",
        "else waveform scroll",
        "Jog: select pad",
        "Jog press: samples",
        "CHOP: play P1 first",
        "Empty pad: new cue",
        "Shift+pad: mark cue",
        "Pads play their chops",
        "Shift: no preview",
        "CHOP starts with no cues",
        "P1 lit, cues light",
        "K3 moves P1 start",
        "Shift+K3: 10ms steps",
        "First start is saved",
        "Erase+pad: empty cue",
        "Each bank keeps mode",
        "Screen follows pad",
        "Capture: re-chop",
        "Up: CHOP > Trim > main",
        "Back: main"
      ]
    },
    {
      "title": "Editor Sound Knobs",
      "lines": [
        "Hold Shift + touch",
        "Master, then touch K3:",
        "trim sound ON / OFF",
        "Hold pad + turn K3/4",
        "Loops stay live",
        "",
        "K1: pad attack",
        "K2: decay / release",
        "Gate: release tail",
        "after pad note-off",
        "K5: Trigger / Gate",
        "K6: pad pitch",
        "K7: pad gain",
        "K8: pad loop",
        "Shift + these knobs:",
        "edit focused bank",
        "Held SRC: auditions",
        "Drums: next pad hit"
      ]
    },
    {
      "title": "FX Presets / Loading",
      "lines": [
        "Up: FX page",
        "K1: named preset",
        "K2-K8: parameters",
        "* = edited/legacy",
        "Project loads show",
        "restore progress.",
        "Samples/save/undo",
        "show a busy screen."
      ]
    },
    {
      "title": "Core Layout",
      "lines": [
        "Two independent 4x4",
        "sections (Left/Right).",
        "Each section has",
        "8 banks x 16 slots.",
        "",
        "Default: Left=Source",
        "Right=Per-Pad"
      ]
    },
    {
      "title": "Pad + Bank",
      "lines": [
        "Pads are side-by-side",
        "4x4 Left + 4x4 Right",
        "on the 4x8 matrix.",
        "Cols 1-4 = Left",
        "Cols 5-8 = Right",
        "",
        "Tap pad to focus slot",
        "and section.",
        "",
        "Overtake bank select:",
        "Step 1-8 = Left B1-8",
        "Step 9-16 = Right B1-8",
        "",
        "Copy+Step: copy bank",
        "source -> destination",
        "while Copy is held",
        "",
        "Delete+Step:",
        "erase that bank",
        "",
        "Delete+Pad:",
        "erase that pad",
        "Undo / Shift+Undo:",
        "undo / redo",
        "Shift+Master turn:",
        "module gain"
      ]
    },
    {
      "title": "Copy Pads",
      "lines": [
        "Hold Copy + tap pad",
        "to set copy source.",
        "",
        "Keep Copy held and",
        "tap another pad to",
        "paste/copy there.",
        "",
        "Release Copy to",
        "clear copy source."
      ]
    },
    {
      "title": "Pad Colors",
      "lines": [
        "Hold Shift +",
        "Volume touch, then:",
        "",
        "K5 turn: edit scope",
        "Pad / Bank",
        "",
        "K6 turn: copy SRC",
        "bank to all banks",
        "",
        "K7 turn: bank color",
        "K8 turn: pad color",
        "(or BANK inherit)",
        "",
        "Color edit is gated",
        "to avoid interfering",
        "with normal controls."
      ]
    },
    {
      "title": "Mode + Browser",
      "lines": [
        "Shift + jog turn:",
        "section mode",
        "(Source / Per-Pad)",
        "",
        "Source mode uses",
        "fixed 16 chops",
        "with long tails",
        "and bank choke.",
        "",
        "Shift + K1-K5:",
        "bank edit Atk/Dec",
        "Start/End/Mode",
        "",
        "Shift + K6 turn:",
        "focused bank pitch",
        "(Main/Trim/CHOP)",
        "Shift + K7 turn:",
        "bank gain",
        "Shift + K8 turn:",
        "bank loop",
        "",
        "Jog click:",
        "open samples browser",
        "Shift+Menu:",
        "session load menu",
        "Shift+Copy:",
        "session save menu",
        "Menu:",
        "open main menu",
        "Back:",
        "exit yes/no",
        "Menu Exit:",
        "exit yes/no",
        "Shift+Vol+Jog:",
        "session load menu",
        "",
        "Jog turn in browser:",
        "scroll files",
        "WAV highlight:",
        "auto-preview",
        "Jog click in browser:",
        "enter/load selected"
      ]
    },
    {
      "title": "Sessions",
      "lines": [
        "Autosave runs when",
        "you change state and",
        "also on module exit.",
        "",
        "Shift + Copy:",
        "open save menu",
        "",
        "Shift + Menu:",
        "open load menu",
        "",
        "Session browser:",
        "K1=char index",
        "K2=char value",
        "Jog edit char in",
        "name edit mode",
        "Copy=save name",
        "Jog click=load/save",
        "Menu Save=current",
        "Save New=new name",
        "Existing save asks",
        "overwrite first",
        "",
        "Shift+Menu:",
        "rename selected",
        "Shift+Copy:",
        "save current name",
        "Shift+Vol+Copy:",
        "duplicate selected",
        "Delete:",
        "delete selected",
        "INIT session is",
        "always available",
        "and is locked"
      ]
    },
    {
      "title": "Record",
      "lines": [
        "Main / Trim / CHOP",
        "Rec button",
        "(main view):",
        "1x arm monitor",
        "(LED blinks)",
        "2x start record",
        "(monitor on)",
        "3x stop record",
        "+monitor off",
        "",
        "Shift+Rec while",
        "recording: stop",
        "and load file to",
        "focused source/pad",
        "",
        "Shift + jog click",
        "(browser): close",
        "browser",
        "",
        "Capture button:",
        "randomize focused",
        "source bank chops"
      ]
    }
  ]
}
